# Copy this file to .env.local and fill in real values.

# Free Postgres database — sign up at https://neon.tech, create a project,
# and copy the connection string it gives you.
DATABASE_URL=

# The single password used to log into the app. Pick anything memorable.
APP_PASSWORD=

# Shown in the confirmation/receipt messages, e.g. "Winton Wanderers Caravan Park".
PARK_NAME=

# Optional — only needed once you're ready to send texts automatically.
# Sign up at https://twilio.com, buy a phone number (a few $/month), and
# copy these three values from the Twilio console. Leave blank for now —
# the app works fine without them, it just copies the message to your
# clipboard instead of sending it.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional — only needed to take deposits by card instead of manually
# recording them. Sign up at https://stripe.com (free to create an account;
# Stripe takes a percentage + flat fee only on money actually processed —
# roughly 1.75% + $0.30 per transaction in Australia). Leave blank for now —
# the app works exactly as before without it, deposits just stay manual.
STRIPE_SECRET_KEY=
# From the Stripe Dashboard → Developers → Webhooks, once you've added an
# endpoint pointing at https://<your-deployed-url>/api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=
# The real https URL this app is deployed at (e.g. https://winton-wanderers.vercel.app).
# Needed so Stripe knows where to send guests back after they pay. Not
# needed for local testing — it falls back to whatever URL you're using.
APP_BASE_URL=

