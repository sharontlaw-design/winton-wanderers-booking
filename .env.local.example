# Copy this file to .env.local and fill in real values.

# Free Postgres database — sign up at https://neon.tech, create a project,
# and copy the connection string it gives you.
DATABASE_URL=

# The single password used to log into the app. Pick anything memorable.
APP_PASSWORD=

# Shown in the confirmation/receipt messages, e.g. "Winton Wanderers Caravan Park".
PARK_NAME=

# Optional — only needed once you're ready to send texts automatically.
# Sign up at https://twilio.com, buy a phone number (a few $/month), and
# copy these three values from the Twilio console. Leave blank for now —
# the app works fine without them, it just copies the message to your
# clipboard instead of sending it.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
